# Machine-specific OmaeStrata paths. Copy to either:
#   ~/.config/omarchy/omaestrata.env   (preferred; survives plugin updates)
#   .env                               (next to BarWidget.qml)
# Or run ./install.sh which writes the preferred file.
#
# MODE=ssh    collector and start script run on SSH_TARGET
# MODE=local  collector and start script run on this machine (STRATA_ROOT)

MODE=ssh
SSH_TARGET=user@hostname
STRATA_ROOT=/home/YOU/Strata
START_SCRIPT=/home/YOU/Strata/run.sh
DISK_PATH=/
PROCESS_PATTERN=strata
REFRESH_SECONDS=10
